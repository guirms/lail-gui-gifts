# Modelo de configuração. Copie para .env e preencha com os valores reais.
#   cp .env.example .env
# O .env é ignorado pelo git — só este exemplo vai pro GitHub.

# Connection string do PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# SSL: auto | true | false
DATABASE_SSL=auto

# Senha compartilhada de acesso ao site (vazio = sem login)
SITE_PASSWORD=

# Chave aleatória para assinar o cookie de sessão
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Nomes do casal, separados por vírgula
PEOPLE=Guilherme,Laís

# Porta do servidor
PORT=3000
